# =============================================================================
# AERO-HUB backend environment
# Copy this file to .env and fill in the values you need.
# NEVER commit the real .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment mode
# -----------------------------------------------------------------------------
# cloud  = mode 2: the Raspberry Pi posts readings to this API, which stores
#          them in MongoDB Atlas and pushes changes to browsers over WebSocket.
# direct = mode 1: this API runs on the Raspberry Pi, reads the sensors itself,
#          stores data in a local file, and serves the dashboard over the LAN.
DATA_MODE=cloud

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# mongodb = MongoDB Atlas (cloud mode)
# file    = append-only local JSONL file (direct mode, survives restarts)
# memory  = no persistence (quick local development / tests)
STORAGE_BACKEND=mongodb
STORAGE_PATH=./data/airsense.jsonl
# File mode keeps this many newest readings in RAM. The JSONL file itself keeps
# growing until you archive or delete it.
FILE_MAX_READINGS=100000

# -----------------------------------------------------------------------------
# MongoDB Atlas (required when STORAGE_BACKEND=mongodb)
# -----------------------------------------------------------------------------
# Atlas -> Database -> Connect -> Drivers -> Python.
# Replace USER, PASSWORD and CLUSTER. URL-encode special characters in the
# password (@ -> %40, : -> %3A, / -> %2F, etc.).
MONGODB_URI=
MONGODB_DB=airsense

# MongoDB change streams are supported on the Atlas free tier. Keep this true
# for realtime updates, including readings inserted by another process.
MONGODB_CHANGE_STREAM=true
MONGODB_TIMEOUT_MS=10000

# Optional automatic deletion of old readings. 0 = keep forever.
# The Atlas free tier has 512 MB; 30 days is a sensible starting value.
READING_RETENTION_DAYS=0

# -----------------------------------------------------------------------------
# Sensor input
# -----------------------------------------------------------------------------
# external = readings arrive through POST /api/sensors/readings (cloud mode)
# hardware = this process reads MCP3008/MQ sensors/BMP280 directly (direct mode)
SENSOR_SOURCE=external
HARDWARE_INTERVAL_SECONDS=5

# Optional shared secret for device ingestion. If set, the Raspberry Pi must
# send the same value in the X-API-Key header (AEROSENSE_API_KEY on the Pi).
DEVICE_API_KEY=

# -----------------------------------------------------------------------------
# Demo data
# -----------------------------------------------------------------------------
DEMO_MODE=false
DEMO_INTERVAL_SECONDS=5
DEMO_LOCATION_NAME=
DEMO_LATITUDE=
DEMO_LONGITUDE=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated browser origins. Use * only for a throwaway local demo.
# For mode 1, include the address where you open the dashboard, for example:
#   FRONTEND_ORIGINS=http://localhost:5173,http://192.168.1.20:5173
FRONTEND_ORIGINS=http://localhost:5173

# =============================================================================
# Raspberry Pi hardware (only used when SENSOR_SOURCE=hardware)
# =============================================================================
DEVICE_LOCATION_NAME=
DEVICE_LATITUDE=
DEVICE_LONGITUDE=
DUST_PARTICLE_SIZE=unknown

ADC_VREF=3.3
SPI_BUS=0
SPI_DEVICE=0
SPI_SPEED_HZ=1350000
MQ7_ADC_CHANNEL=0
MQ135_ADC_CHANNEL=1
DUST_ADC_CHANNEL=2
DUST_LED_GPIO=17
MQ_LOAD_RESISTOR_KOHM=10

# Calibration: leave blank until you have real reference measurements.
MQ7_R0_KOHM=
MQ7_CURVE_SLOPE=
MQ7_CURVE_INTERCEPT=
MQ135_R0_KOHM=
MQ135_CURVE_SLOPE=
MQ135_CURVE_INTERCEPT=
DUST_ZERO_VOLTAGE=
DUST_UG_M3_PER_V=
