# =============================================================================
# AERO-HUB backend environment
# Copy this file to .env and fill in the values you need.
# NEVER commit the real .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment mode
# -----------------------------------------------------------------------------
# cloud  = mode 2: the Raspberry Pi posts readings to this API, which stores
#          them in MongoDB Atlas and pushes changes to browsers over WebSocket.
# direct = mode 1: this API runs on the Raspberry Pi, reads the sensors itself,
#          and serves the dashboard/API. Storage can be a local file or Atlas.
DATA_MODE=cloud

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# mongodb = MongoDB Atlas (cloud mode, or direct mode with remote history)
# file    = append-only local JSONL file (direct mode, survives restarts)
# memory  = no persistence (quick local development / tests)
STORAGE_BACKEND=mongodb
STORAGE_PATH=./data/airsense.jsonl
# File mode keeps this many newest readings in RAM. The JSONL file itself keeps
# growing until you archive or delete it.
FILE_MAX_READINGS=100000

# -----------------------------------------------------------------------------
# MongoDB Atlas (required when STORAGE_BACKEND=mongodb)
# -----------------------------------------------------------------------------
# Atlas -> Database -> Connect -> Drivers -> Python.
# Replace USER, PASSWORD and CLUSTER. URL-encode special characters in the
# password (@ -> %40, : -> %3A, / -> %2F, etc.).
MONGODB_URI=
MONGODB_DB=airsense

# MongoDB change streams are supported on the Atlas free tier. Keep this true
# for realtime updates, including readings inserted by another process.
MONGODB_CHANGE_STREAM=true
MONGODB_TIMEOUT_MS=10000

# Optional automatic deletion of old readings. 0 = keep forever.
# The Atlas free tier has 512 MB; at 1 reading/sec use 7 (about 200 MB) or less.
READING_RETENTION_DAYS=0

# -----------------------------------------------------------------------------
# Sensor input
# -----------------------------------------------------------------------------
# external = readings arrive through POST /api/sensors/readings (cloud mode)
# hardware = this process reads MCP3008/MQ sensors/BMP280 directly (direct mode)
SENSOR_SOURCE=external
# 1 = one sample per second. Raise it if you want lower write volume.
HARDWARE_INTERVAL_SECONDS=1

# Optional shared secret for device ingestion. If set, the Raspberry Pi must
# send the same value in the X-API-Key header (AEROSENSE_API_KEY on the Pi).
DEVICE_API_KEY=

# -----------------------------------------------------------------------------
# Demo data
# -----------------------------------------------------------------------------
DEMO_MODE=false
DEMO_INTERVAL_SECONDS=5
DEMO_LOCATION_NAME=
DEMO_LATITUDE=
DEMO_LONGITUDE=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated browser origins. Use * only for a throwaway local demo.
# For mode 1, include the address where you open the dashboard, for example:
#   FRONTEND_ORIGINS=http://localhost:5173,http://192.168.1.20:5173
# For Vercel, add the production domain exactly, for example:
#   FRONTEND_ORIGINS=https://aerohub.vercel.app
FRONTEND_ORIGINS=http://localhost:5173

# =============================================================================
# Raspberry Pi hardware (only used when SENSOR_SOURCE=hardware)
# =============================================================================
DEVICE_LOCATION_NAME=
DEVICE_LATITUDE=
DEVICE_LONGITUDE=
DUST_PARTICLE_SIZE=unknown

# ADC backend: mcp3008 (SPI), ads1015 / ads1115 (I2C), arduino (USB serial),
# or none.
ADC_BACKEND=arduino
# Serial link: /dev/ttyACM0 for USB (official Uno), /dev/ttyUSB0 for a CH340
# clone, or /dev/serial0 when the Uno is powered separately and wired to the
# Pi GPIO UART (pins 8/10).
ARDUINO_PORT=/dev/ttyACM0
ARDUINO_BAUD=115200
# 2.0 for USB (the Uno resets when the port opens), 0 for the GPIO UART.
ARDUINO_BOOT_SECONDS=2.0
ARDUINO_VREF=5.0
ARDUINO_ADC_MAX=1023
# true  = Arduino D7 pulses the dust LED (precise timing, recommended).
# false = keep the LED control wire on Pi GPIO17 and pulse it from the Pi.
ARDUINO_DUST_LED=true

# ADS1115 / ADS1015 alternative (ignore when ADC_BACKEND=arduino):
# ADS1X15_ADDRESS=0x48
# ADS1X15_I2C_BUS=1
# ADS1X15_FULL_SCALE_V=4.096
# ADS1X15_DATA_RATE=860

ADC_VREF=3.3
SPI_BUS=0
SPI_DEVICE=0
SPI_SPEED_HZ=1350000
MQ7_ADC_CHANNEL=0
MQ135_ADC_CHANNEL=1
DUST_ADC_CHANNEL=2
DUST_LED_GPIO=17
# false = LED on when the GPIO is LOW (direct drive / PNP high-side)
# true  = LED on when the GPIO is HIGH (NPN low-side transistor, recommended)
DUST_LED_ACTIVE_HIGH=false
MQ_LOAD_RESISTOR_KOHM=10

# MQ sensors run their heaters from 5 V, so their AOUT can reach 5 V.
# With the Arduino backend connect MQ AOUT directly to A0/A1 and keep this at 1.
# If you switch to a 3.3 V ADC (ADS1115/MCP3008), fit a 10k/20k divider and set
# MQ_DIVIDER_RATIO=1.5; a 5 V input can permanently damage those chips.
MQ_SUPPLY_VOLTAGE=5
MQ_DIVIDER_RATIO=1
# Your Sharp dust board is already conditioned: leave at 1 unless you added a
# divider after it, in which case use the same (Rtop+Rbottom)/Rbottom value.
DUST_DIVIDER_RATIO=1

# BMP280 / HW-611 address: 0x76 when SDO is low, 0x77 when SDO is high.
BMP280_I2C_ADDRESS=0x76

# Phone GPS over the network (no gpsd needed).
# GPS_MODE=tcp: the phone app listens, the Pi connects (gpsdRelay / Share GPS).
# GPS_MODE=udp: the Pi listens on GPS_PORT (GPSd Forwarder).
GPS_ENABLED=false
GPS_MODE=tcp
GPS_HOST=
GPS_PORT=10110
GPS_MAX_AGE_SECONDS=30
GPS_LOCATION_NAME=Mobile GPS

# Optional 16x2 I2C LCD (PCF8574 backpack).
LCD_ENABLED=false
LCD_I2C_BUS=1
LCD_I2C_ADDRESS=0x27
LCD_COLUMNS=16
LCD_ROWS=2
LCD_PAGE_SECONDS=4

# Calibration: leave blank until you have real reference measurements.
MQ7_R0_KOHM=
MQ7_CURVE_SLOPE=
MQ7_CURVE_INTERCEPT=
MQ135_R0_KOHM=
MQ135_CURVE_SLOPE=
MQ135_CURVE_INTERCEPT=
DUST_ZERO_VOLTAGE=
DUST_UG_M3_PER_V=
