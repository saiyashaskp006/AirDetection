# cloud  = dashboard talks to the API + MongoDB backend (mode 2)
# direct = dashboard talks to the Raspberry Pi running the local API (mode 1)
VITE_DATA_MODE=cloud

VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/readings

# For Vercel, set these in Project Settings -> Environment Variables instead of
# committing them. They must be HTTPS/WSS because the Vercel site is HTTPS:
#
# VITE_DATA_MODE=direct
# VITE_API_URL=https://your-pi-tunnel.example.com
# VITE_WS_URL=wss://your-pi-tunnel.example.com/ws/readings
#
# Vite bakes these values into the build, so redeploy after changing them.
# See docs/VERCEL_DEPLOY.md.
