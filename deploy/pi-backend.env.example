# =============================================================================
# AERO-HUB backend on the Raspberry Pi (direct mode + MongoDB Atlas)
# Copy to backend/.env on the Pi and fill in the values marked FILL.
# Never commit the real file.
# =============================================================================

DATA_MODE=direct
STORAGE_BACKEND=mongodb

# FILL: the same Atlas cluster/database used by the laptop backend.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGODB_DB=airsense
MONGODB_CHANGE_STREAM=true
MONGODB_TIMEOUT_MS=10000
# 0 = keep every reading. For continuous 1 Hz operation, 7 days is roughly
# 200 MB and fits the Atlas free tier; enable it after you no longer need the
# older test readings.
READING_RETENTION_DAYS=0

# This process reads the sensors itself. Do not also run raspberry_pi.py.
SENSOR_SOURCE=hardware
HARDWARE_INTERVAL_SECONDS=1

# Protect the external ingestion route in case you use it later.
# Generate one with: openssl rand -hex 32
DEVICE_API_KEY=

# FILL: the Vercel production origin, exactly, with no trailing slash.
# Add http://localhost:5173 too if you also run `npm run dev` locally.
FRONTEND_ORIGINS=https://your-project.vercel.app

DEMO_MODE=false
DEMO_INTERVAL_SECONDS=5
DEMO_LOCATION_NAME=
DEMO_LATITUDE=
DEMO_LONGITUDE=

# -----------------------------------------------------------------------------
# Sensor location
# -----------------------------------------------------------------------------
DEVICE_LOCATION_NAME=North campus
DEVICE_LATITUDE=28.6139
DEVICE_LONGITUDE=77.2090
DUST_PARTICLE_SIZE=unknown

# -----------------------------------------------------------------------------
# Hardware (same values as raspberry_pi/.env)
# -----------------------------------------------------------------------------
ADC_BACKEND=arduino
ARDUINO_PORT=/dev/serial0
ARDUINO_BAUD=115200
# 0 for the GPIO UART; 2.0 for USB (/dev/ttyACM0).
ARDUINO_BOOT_SECONDS=0
ARDUINO_VREF=5.0
ARDUINO_ADC_MAX=1023
ARDUINO_DUST_LED=true
ARDUINO_TIMEOUT=0.5

ADC_VREF=3.3
SPI_BUS=0
SPI_DEVICE=0
MQ7_ADC_CHANNEL=0
MQ135_ADC_CHANNEL=1
DUST_ADC_CHANNEL=2
DUST_LED_GPIO=17
DUST_LED_ACTIVE_HIGH=false
MQ_LOAD_RESISTOR_KOHM=10
MQ_SUPPLY_VOLTAGE=5
MQ_DIVIDER_RATIO=1
DUST_DIVIDER_RATIO=1

BMP280_I2C_ADDRESS=0x77
GPS_ENABLED=false
LCD_ENABLED=false

# Optional calibration. Leave blank until you have reference values.
MQ7_R0_KOHM=
MQ7_CURVE_SLOPE=
MQ7_CURVE_INTERCEPT=
MQ135_R0_KOHM=
MQ135_CURVE_SLOPE=
MQ135_CURVE_INTERCEPT=
DUST_ZERO_VOLTAGE=
DUST_UG_M3_PER_V=
