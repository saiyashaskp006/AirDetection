[Unit]
Description=AERO-HUB FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change User and the three paths below if your Pi user or repo location differs.
User=pi
Group=pi
WorkingDirectory=/home/pi/AirDetection/backend
Environment=PYTHONUNBUFFERED=1
# 127.0.0.1 is enough when Tailscale Funnel or Cloudflare Tunnel runs on the
# same Pi. Use --host 0.0.0.0 only if you also want direct LAN access.
ExecStart=/home/pi/AirDetection/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
