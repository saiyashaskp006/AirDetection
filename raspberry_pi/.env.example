# =============================================================================
# Raspberry Pi sensor client (cloud mode)
# Copy to .env and fill in.
# =============================================================================

# URL of the backend that stores data in MongoDB. Use the LAN address of the
# computer/server running FastAPI, not localhost (the Pi is a different device).
AEROSENSE_API_URL=http://192.168.1.100:8000

# Must match DEVICE_API_KEY in backend/.env. Leave both blank to disable.
AEROSENSE_API_KEY=

READ_INTERVAL_SECONDS=5

# Optional site metadata attached to every reading.
AEROSENSE_SITE_NAME=
AEROSENSE_LATITUDE=
AEROSENSE_LONGITUDE=
DUST_PARTICLE_SIZE=unknown

# MCP3008 / sensor wiring
ADC_VREF=3.3
SPI_BUS=0
SPI_DEVICE=0
MQ7_ADC_CHANNEL=0
MQ135_ADC_CHANNEL=1
DUST_ADC_CHANNEL=2
DUST_LED_GPIO=17
MQ_LOAD_RESISTOR_KOHM=10

# Calibration: leave blank until you have real reference measurements.
MQ7_R0_KOHM=
MQ7_CURVE_SLOPE=
MQ7_CURVE_INTERCEPT=
MQ135_R0_KOHM=
MQ135_CURVE_SLOPE=
MQ135_CURVE_INTERCEPT=
DUST_ZERO_VOLTAGE=
DUST_UG_M3_PER_V=

LOG_LEVEL=INFO
